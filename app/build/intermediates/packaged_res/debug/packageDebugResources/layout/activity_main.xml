<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main_content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Hero header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">

            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/logo_frictionizer"
                android:contentDescription="Frictionizer Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FRICTIONIZER"
                android:textColor="@color/teal"
                android:textSize="28sp"
                android:letterSpacing="0.15"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pause before you scroll"
                android:textColor="#80FFFFFF"
                android:textSize="13sp"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- Battery optimization card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardElevation="4dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battery Optimization"
                    android:textColor="@color/teal"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:paddingBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Frictionizer needs to run in the background to detect app launches. Please disable battery optimization for best results."
                    android:textColor="#B0B0B0"
                    android:textSize="13sp"
                    android:paddingBottom="12dp" />

                <Button
                    android:id="@+id/btn_disable_battery_opt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Disable Optimization"
                    android:backgroundTint="@color/teal"
                    android:textColor="#FFFFFF"
                    style="@style/Widget.MaterialComponents.Button" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Service status card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_service_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Checking service status..."
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_enable_service"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable in Accessibility Settings"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="@color/teal"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    style="@style/Widget.MaterialComponents.Button" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Select Apps -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardElevation="4dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monitored Apps"
                    android:textColor="@color/teal"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:paddingBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose which apps trigger the friction popup"
                    android:textColor="#B0B0B0"
                    android:textSize="13sp"
                    android:paddingBottom="12dp" />

                <Button
                    android:id="@+id/btn_select_apps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Apps"
                    android:backgroundTint="@color/teal"
                    android:textColor="#FFFFFF"
                    style="@style/Widget.MaterialComponents.Button" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Manage Activities -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardElevation="4dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Activities"
                    android:textColor="@color/teal"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:paddingBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customise the reasons shown in the popup"
                    android:textColor="#B0B0B0"
                    android:textSize="13sp"
                    android:paddingBottom="12dp" />

                <Button
                    android:id="@+id/btn_manage_activities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Manage Activities"
                    android:backgroundTint="@color/teal"
                    android:textColor="#FFFFFF"
                    style="@style/Widget.MaterialComponents.Button" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Stats -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardElevation="4dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Usage Stats"
                    android:textColor="@color/teal"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:paddingBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See time spent per app and activity"
                    android:textColor="#B0B0B0"
                    android:textSize="13sp"
                    android:paddingBottom="12dp" />

                <Button
                    android:id="@+id/btn_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View Stats"
                    android:backgroundTint="@color/teal"
                    android:textColor="#FFFFFF"
                    style="@style/Widget.MaterialComponents.Button" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
