<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        style="@style/Frictionizer.Toolbar">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="match_parent"
            android:src="@drawable/frictionizer_wordmark"
            android:scaleType="fitStart"
            android:contentDescription="Frictionizer" />

    </androidx.appcompat.widget.Toolbar>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

    <ScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- App Status Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/status_active"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tv_service_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Service active — Frictionizer is running"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center" />
                    <Button
                        android:id="@+id/btn_enable_service"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="12dp"
                        android:text="Enable in Settings"
                        android:textColor="@color/primary"
                        android:backgroundTint="@color/white"
                        style="@style/Widget.MaterialComponents.Button" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Battery Optimization Warning -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#FFF8E1"
                app:cardElevation="0dp"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Service may be killed by system. Disable battery optimization for best results."
                        android:textColor="#856404"
                        android:textSize="12sp" />
                    <Button
                        android:id="@+id/btn_disable_battery_opt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fix"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:textColor="#856404" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Actions -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONFIGURATION"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-medium"
                android:paddingBottom="12dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/surface"
                app:cardElevation="2dp"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Select Apps -->
                    <Button
                        android:id="@+id/btn_select_apps"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="Select Monitored Apps"
                        android:textColor="@color/text_primary"
                        android:gravity="center_vertical|start"
                        android:paddingHorizontal="20dp"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        app:icon="@drawable/search_bg"
                        app:iconTint="@color/primary" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                    <!-- Manage Activities -->
                    <Button
                        android:id="@+id/btn_manage_activities"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="Manage Activities"
                        android:textColor="@color/text_primary"
                        android:gravity="center_vertical|start"
                        android:paddingHorizontal="20dp"
                        style="@style/Widget.MaterialComponents.Button.TextButton" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

                    <!-- Settings -->
                    <Button
                        android:id="@+id/btn_settings"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="Countdown &amp; Bedtime Settings"
                        android:textColor="@color/text_primary"
                        android:gravity="center_vertical|start"
                        android:paddingHorizontal="20dp"
                        style="@style/Widget.MaterialComponents.Button.TextButton" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Stats -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INSIGHTS"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-medium"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/btn_stats"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="View Usage Statistics"
                android:textColor="@color/white"
                android:backgroundTint="@color/primary"
                app:cornerRadius="16dp"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
