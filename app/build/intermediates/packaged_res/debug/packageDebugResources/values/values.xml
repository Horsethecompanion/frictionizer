<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg_dark">#0D0D12</color>
    <color name="card_dark">#16161E</color>
    <color name="outline">#2C2C3A</color>
    <color name="scrim">#DD000000</color>
    <color name="status_active">#2DD4BF</color>
    <color name="status_inactive">#F87171</color>
    <color name="teal">#00E5FF</color>
    <color name="teal_dark">#00B8D4</color>
    <color name="white">#F0F0F5</color>
    <color name="white_muted">#80F0F0F5</color>
    <string name="accessibility_service_description">Frictionizer watches for app launches and briefly pauses you with a simple question — helping you be more intentional about how you use your time.</string>
    <string name="accessibility_service_label">Frictionizer</string>
    <string name="action_skip">Skip</string>
    <string name="app_name">Frictionizer</string>
    <string name="title_manage_activities">Manage Activities</string>
    <string name="title_select_apps">Select Apps</string>
    <string name="title_stats">Usage Stats</string>
    <style name="Frictionizer.ActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@color/card_dark</item>
        <item name="titleTextStyle">@style/Frictionizer.ActionBar.TitleText</item>
    </style>
    <style name="Frictionizer.ActionBar.TitleText" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/teal</item>
    </style>
    <style name="Theme.Frictionizer" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/teal</item>
        <item name="colorPrimaryVariant">@color/teal_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/card_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="actionBarStyle">@style/Frictionizer.ActionBar</item>
    </style>
</resources>