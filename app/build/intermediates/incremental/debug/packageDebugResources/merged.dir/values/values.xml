    <string name="accessibility_service_description">Monitors app launches to add intentional friction and prevent mindless scrolling.</string>
    <string name="accessibility_service_label">Frictionizer Guard</string>
    <string name="action_skip">Skip</string>
    <string name="app_name">Frictionizer</string>
    <string name="title_manage_activities">Activities</string>
    <string name="title_select_apps">Monitored Apps</string>
    <string name="title_settings">Settings</string>
    <string name="title_stats">Usage Stats</string>
    <style name="Frictionizer.OverlayChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:textColor">@color/overlay_text</item>
        <item name="chipBackgroundColor">@color/overlay_chip_bg</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textSize">16sp</item>
        <item name="chipMinHeight">52dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
    <style name="Frictionizer.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/surface</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="titleTextAppearance">@style/Frictionizer.ToolbarTitle</item>
    </style>
    <style name="Frictionizer.ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
    <style name="Theme.Frictionizer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Frictionizer.Night" parent="Theme.Frictionizer">
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>