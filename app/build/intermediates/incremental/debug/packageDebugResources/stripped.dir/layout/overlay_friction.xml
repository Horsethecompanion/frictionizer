<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen overlay shown when a monitored app is launched -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlay_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim"
    android:clickable="true"
    android:focusable="true">

    <!-- Center card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/card_dark"
        app:cardCornerRadius="28dp"
        app:cardElevation="32dp"
        app:cardMaxElevation="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/logo_frictionizer"
                    android:contentDescription="Logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FRICTIONIZER"
                        android:textColor="@color/teal"
                        android:textSize="11sp"
                        android:letterSpacing="0.3"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        android:id="@+id/tv_opening_app"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Opening App"
                        android:textColor="@color/white_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What are you doing?"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="16dp" />

            <!-- Activity Chips (Scrollable Vertical List) -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="16dp"
                android:fadeScrollbars="false"
                android:scrollbars="vertical">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_activities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="false"
                    app:chipSpacingVertical="4dp"
                    app:singleLine="false" />
            </androidx.core.widget.NestedScrollView>

            <!-- Go button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_go"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Unlock App"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                app:backgroundTint="@color/teal"
                android:textColor="@color/bg_dark"
                app:cornerRadius="28dp" />

            <!-- Skip -->
            <Button
                android:id="@+id/btn_skip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_skip"
                android:textColor="@color/white_muted"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:layout_marginTop="8dp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
