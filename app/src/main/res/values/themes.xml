<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Frictionizer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Dark status bar for dark mode -->
    <style name="Theme.Frictionizer.Night" parent="Theme.Frictionizer">
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Toolbar used in all activities -->
    <style name="Frictionizer.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/surface</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="titleTextAppearance">@style/Frictionizer.ToolbarTitle</item>
    </style>

    <style name="Frictionizer.ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- Chip style for overlay -->
    <style name="Frictionizer.OverlayChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:textColor">@color/overlay_text</item>
        <item name="chipBackgroundColor">@color/overlay_chip_bg</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textSize">16sp</item>
        <item name="chipMinHeight">52dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
</resources>
